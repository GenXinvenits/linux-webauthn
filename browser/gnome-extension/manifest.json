{
  "manifest_version": 2,
  "name": "LINUX WebAuthn",
  "version": "0.1.0",
  "description": "LINUX-native WebAuthn integration",

  "permissions": [
    "nativeMessaging",
    "tabs",
    "<all_urls>"
  ],

  "background": {
    "scripts": [
      "background.js"
    ]
  },

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],

  "web_accessible_resources": [
    "page-bridge.js"
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "linux-webauthn@dibacii.com"
    }
  }
}
